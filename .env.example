# Database (for local SQLite)
TURSO_DATABASE_URL="file:./prisma/local.db"
TURSO_AUTH_TOKEN="local-dev-token"

# Auth
AUTH_SECRET="your-auth-secret-at-least-32-chars"
AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="your-better-auth-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (get from Google Cloud Console)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Cloudflare R2 Storage
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_KEY_ID="your-r2-secret-key"
R2_BUCKET_NAME="your-bucket-name"
R2_CUSTOM_DOMAIN="https://your-r2-domain.com"

# Resend Email
RESEND_API_KEY="re_your_resend_api_key"

# Stripe
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY="price_your_monthly_price_id"
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY="price_your_yearly_price_id"
NEXT_PUBLIC_STRIPE_PRICE_BASIC="price_your_basic_price_id"

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY="phc_your_posthog_key"
